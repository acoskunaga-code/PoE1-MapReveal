  <ItemGroup>
    <!-- Radar'in onemli karo listesi: cikislarin kesin yeri ve gittigi yerin adi. -->
    <None Include="..\data\important_tgt_files.txt" Link="important_tgt_files.txt" Condition="Exists('..\data\important_tgt_files.txt')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\radar-targets.json" Link="data\radar-targets.json" Condition="Exists('..\data\radar-targets.json')" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ayar penceresinin Icons sekmesi: ucuncu taraf simge verisi, isteye bagli (data/README.md). -->
    <None Include="..\data\icons\catalog.txt" Link="data\icons\catalog.txt" Condition="Exists('..\data\icons\catalog.txt')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\icons\Icons.png" Link="data\icons\Icons.png" Condition="Exists('..\data\icons\Icons.png')" CopyToOutputDirectory="PreserveNewest" />
    <!-- Yerdeki unique'lerin adi: RePoE uniques.json, isteye bagli (data/README.md). -->
    <None Include="..\data\uniques.json" Link="data\uniques.json" Condition="Exists('..\data\uniques.json')" CopyToOutputDirectory="PreserveNewest" />
    <!-- Uniques sekmesinin listesi: MapScan uniquetiers ile filtreden + poewiki'den uretilir, isteye bagli. -->
    <None Include="..\data\unique-tiers.txt" Link="data\unique-tiers.txt" Condition="Exists('..\data\unique-tiers.txt')" CopyToOutputDirectory="PreserveNewest" />
