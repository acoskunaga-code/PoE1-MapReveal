<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ayarsiz harita: calistirinca harita oyunda belirir. Pencere yok, ayar yok.
    Butun kod MapView ve MapScan ile ortak; burada sadece onlari birbirine baglayan
    kucuk bir denetleyici var. MapView gelistirme ve ayar araci olarak kaliyor.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>BunuYazanTosun</AssemblyName>
    <RootNamespace>Poe2Map</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Debug derlemesinde bile iyilestirici acik: varsayilan Debug'ta JIT iyilestiricisi kapali ve her yontem
         optimizasyonsuz derleniyor; saniyede 60 kez calisan okuma/cizim dongusu ile harita uretimi bundan yavasliyordu. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MapScan\Native.cs" Link="Shared\Native.cs" />
    <Compile Include="..\MapScan\GameLayout.cs" Link="Shared\GameLayout.cs" />
    <Compile Include="..\MapScan\MemoryRegions.cs" Link="Shared\MemoryRegions.cs" />
